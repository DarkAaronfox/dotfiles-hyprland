# Allowlist: ignore everything, then re-include tracked configs
/*
!.gitignore
!README.md

!/hypr/
!/quickshell/
!/kitty/
!/fish/
!/btop/
!/cava/
!/matugen/
!/micro/
!/mpv/
!/mpd/
!/gtk-3.0/
!/gtk-4.0/
!/qt6ct/
!/nwg-look/
!/spicetify/
!/autostart/
!/systemd/
!/kdeglobals
!/mimeapps.list

__pycache__/
fish/fish_variables
micro/backups/
micro/buffers/
quickshell/sddm/*/fonts/
quickshell/notifications.json
quickshell/activity.json
# uosc is third-party (reinstall from upstream, ships ~17 MB of binaries)
mpv/scripts/uosc/
mpv/fonts/

# Local backup copies
*.bak
*.bak-*
*.bak.*
